# One KEY=value per line. Comments go on their own lines. This file is not run
# through a shell: paste generated values, never "$(...)".

# PostgreSQL connection string. setup.sh fills in a random database password.
DATABASE_URL=postgres://penkeeper:CHANGE_ME_DB_PASSWORD@localhost:5432/penkeeper?sslmode=disable

# Secret used to sign and verify JWT tokens (required, at least 32 bytes).
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Server listen port (optional, defaults to 1338)
PORT=1338

# Key for encrypting credentials and TOTP secrets at rest (optional, derived
# from JWT_SECRET if not set). Use a separate key in production, and never
# change it once credentials are saved.
# Generate with: openssl rand -hex 32
# ENCRYPTION_KEY=

# Allowed CORS origins (optional, comma-separated). Leave unset for
# same-origin deployments.
# ALLOWED_ORIGINS=https://penkeeper.example.com

# SMTP settings for password reset emails (all optional — if SMTP_HOST is not
# set, reset URLs are logged to stdout instead of emailed).
# SMTP_PORT defaults to 587 (STARTTLS). SMTP_FROM defaults to SMTP_USER.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@example.com

# Public URL used in password reset links (defaults to http://localhost:PORT).
# Behind a reverse proxy, set it to the URL users open.
# APP_URL=https://penkeeper.example.com
